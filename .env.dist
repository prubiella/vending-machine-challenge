###> PROJECT HOSTNAME VARIABLES ###
PROJECT_HOSTNAME="vending-machine.test"
###< PROJECT HOSTNAME VARIABLES ###

###> host user (make first-run writes yours) ###
USER_ID=1000
GROUP_ID=1000
###< host user ###

###> xdebug (off to disable it) ###
XDEBUG_MODE=develop,debug,coverage
###< xdebug ###

###> docker ports ###
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
MYSQL_PORT=3307
MONGO_PORT=27018
###< docker ports ###

###> docker images (the defaults of docker-compose.yml, to pin or bump them) ###
TRAEFIK_VERSION=v3.7.18
SWAGGER_UI_VERSION=v5.34.1
PHPMYADMIN_VERSION=5.2.3
MONGO_EXPRESS_VERSION=1.0.2-20
###< docker images ###

###> mysql ###
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
###< mysql ###

###> mongo ###
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
MONGO_DATABASE=app
###< mongo ###

###> database web tools (make tools; local development only) ###
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
###< database web tools ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=PRIVATE_SUBNETS
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The mysql service on the compose network; the test environment adds _test to the database name.
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?serverVersion=8.4.13&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> vending machine ###
# The id of the one machine this installation runs: an RFC 4122 UUID (ADR 17). The default lives in
# config/services.yaml; uncomment and change this line to run the machine under another id.
#VENDING_MACHINE_ID=
###< vending machine ###

###> mongodb/mongodb ###
# The mongo service on the compose network; the test environment adds _test to the database name.
MONGODB_URL="mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@mongo:27017"
MONGODB_DATABASE=${MONGO_DATABASE}
###< mongodb/mongodb ###

###> lexik/jwt-authentication-bundle ###
# The key pair that signs the technicians' tokens, which make jwt-keys creates and git ignores. An
# empty passphrase leaves those local keys unencrypted; set one, and other paths, where it matters.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
