###> PROJECT HOSTNAME VARIABLES ###
PROJECT_HOSTNAME="vending-machine.test"
###< PROJECT HOSTNAME VARIABLES ###

###> host user (make first-run writes yours) ###
USER_ID=1000
GROUP_ID=1000
###< host user ###

###> xdebug (off to disable it) ###
XDEBUG_MODE=develop,debug,coverage
###< xdebug ###

###> docker ports ###
MYSQL_PORT=3307
###< docker ports ###

###> mysql ###
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
###< mysql ###
