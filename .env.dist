###> PROJECT HOSTNAME VARIABLES ###
PROJECT_HOSTNAME="vending-machine.test"
###< PROJECT HOSTNAME VARIABLES ###

###> docker ports ###
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
MYSQL_PORT=3307
###< docker ports ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=PRIVATE_SUBNETS
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://vending-machine.test
###< symfony/routing ###
