###> PROJECT HOSTNAME VARIABLES ###
PROJECT_HOSTNAME="vending-machine.test"
###< PROJECT HOSTNAME VARIABLES ###

###> host user (make first-run writes yours) ###
USER_ID=1000
GROUP_ID=1000
###< host user ###

###> xdebug (off to disable it) ###
XDEBUG_MODE=develop,debug,coverage
###< xdebug ###

###> docker ports ###
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
MYSQL_PORT=3307
###< docker ports ###

###> mysql ###
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
###< mysql ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=PRIVATE_SUBNETS
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://vending-machine.test
###< symfony/routing ###
