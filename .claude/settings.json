{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make status)",
      "Bash(make logs:*)",
      "Bash(make start)",
      "Bash(make stop)",
      "Bash(make install)",
      "Bash(make run:*)",
      "Bash(make test:*)",
      "Bash(make coverage:*)",
      "Bash(make phpstan)",
      "Bash(make deptrac)",
      "Bash(make cs-fixer)",
      "Bash(make code-check)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec php-fpm:*)",
      "Bash(docker compose exec -T php-fpm:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Edit(.audit/vm-review/**)"
    ],
    "deny": [
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(make destroy)"
    ]
  }
}
