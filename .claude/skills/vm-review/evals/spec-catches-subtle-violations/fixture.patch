+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain\Money;
+
+enum Coin: int
+{
+    case FiveCents = 5;
+    case TenCents = 10;
+    case TwentyFiveCents = 25;
+    case OneUnit = 100;
+
+    /**
+     * @return list<self>
+     */
+    public static function fromLargest(): array
+    {
+        return [self::OneUnit, self::TwentyFiveCents, self::TenCents, self::FiveCents];
+    }
+}
