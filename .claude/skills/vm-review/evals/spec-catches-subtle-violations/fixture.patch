@@ -0,0 +1,13 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain\Money;
+
+final class ExactChangeNotAvailable extends \DomainException
+{
+    public static function for(int $cents): self
+    {
+        return new self(\sprintf('Cannot give exact change for %d cents with the coins in stock.', $cents));
+    }
+}
