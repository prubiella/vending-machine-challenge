@@ -0,0 +1,32 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Tests\Unit\Domain\Money;
+
+use App\Domain\Money\Coin;
+use App\Domain\Money\CoinStock;
+use App\Domain\Money\ExactChangeNotAvailable;
+use PHPUnit\Framework\TestCase;
+
+final class CoinStockTest extends TestCase
+{
+    public function testGivesTheChangeFromTheCoinsInStock(): void
+    {
+        $stock = new CoinStock();
+        $stock->add(Coin::TwentyFiveCents, 2);
+        $stock->add(Coin::TenCents);
+
+        self::assertSame([Coin::TwentyFiveCents, Coin::TenCents], $stock->giveChange(35));
+    }
+
+    public function testRefusesWhenTheExactChangeIsNotInStock(): void
+    {
+        $stock = new CoinStock();
+        $stock->add(Coin::TwentyFiveCents);
+
+        $this->expectException(ExactChangeNotAvailable::class);
+
+        $stock->giveChange(10);
+    }
+}
