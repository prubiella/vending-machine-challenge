@@ -0,0 +1,47 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain\Money;
+
+final class CoinStock
+{
+    /**
+     * @var array<int, int>
+     */
+    private array $counts = [];
+
+    public function add(Coin $coin, int $quantity = 1): void
+    {
+        $this->counts[$coin->value] = $this->count($coin) + $quantity;
+    }
+
+    public function count(Coin $coin): int
+    {
+        return $this->counts[$coin->value] ?? 0;
+    }
+
+    /**
+     * @return list<Coin>
+     */
+    public function giveChange(int $cents): array
+    {
+        $available = $this->counts;
+        $change = [];
+        $remaining = $cents;
+
+        foreach (Coin::fromLargest() as $coin) {
+            while ($remaining >= $coin->value && ($available[$coin->value] ?? 0) > 0) {
+                $change[] = $coin;
+                $remaining -= $coin->value;
+                --$available[$coin->value];
+            }
+        }
+
+        if (0 !== $remaining) {
+            throw ExactChangeNotAvailable::for($cents);
+        }
+
+        return $change;
+    }
+}
