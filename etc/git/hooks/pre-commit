#!/usr/local/bin/php
<?php

declare(strict_types=1);

if (!is_file(__DIR__.'/../../../vendor/autoload.php')) {
    fwrite(\STDERR, "No vendor/ in this checkout (a new git worktree?). Install it with:\n  ./etc/git/hooks-docker/run-in-php-image.sh composer install\n");
    exit(1);
}

require __DIR__.'/../../../vendor/autoload.php';

use Symfony\Component\Process\Process;

const CHECKED_PATHS = '/^(src\/|tests\/|config\/|composer\.(json|lock)$|phpunit\.dist\.xml$|phpstan\.dist\.neon$|deptrac\.yaml$|\.php-cs-fixer\.dist\.php$)/';
const PHP_FILE = '/\.php$/';

function stagedFiles(): array
{
    $process = new Process(['git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR']);
    $process->mustRun();

    return array_values(array_filter(explode("\n", $process->getOutput())));
}

function runCheck(string $check, array $command): void
{
    echo "\033[32m{$check}\033[0m\n";

    $process = new Process($command);
    $process->setTimeout(3600);
    $process->run(static function (string $type, string $buffer): void {
        echo $buffer;
    });

    if (!$process->isSuccessful()) {
        fwrite(\STDERR, "{$check} failed, fix it before committing.\n");
        exit(1);
    }
}

$staged = stagedFiles();

if (in_array('composer.json', $staged, true) && !in_array('composer.lock', $staged, true)) {
    fwrite(\STDERR, "composer.json is staged without composer.lock.\n");
    exit(1);
}

$checked = array_values(array_filter($staged, static fn (string $file): bool => 1 === preg_match(CHECKED_PATHS, $file)));

if ([] === $checked) {
    exit(0);
}

$phpFiles = array_values(array_filter($checked, static fn (string $file): bool => 1 === preg_match(PHP_FILE, $file)));

if ([] !== $phpFiles) {
    runCheck('Coding standard', ['vendor/bin/php-cs-fixer', 'check', '--config=.php-cs-fixer.dist.php', '--path-mode=intersection', ...$phpFiles]);
}
runCheck('Container', ['bin/console', 'lint:container']);
runCheck('PHPStan', ['vendor/bin/phpstan', 'analyse', '--no-progress']);
runCheck('Layer dependencies', ['vendor/bin/deptrac', '--no-progress']);
runCheck('Tests', ['vendor/bin/phpunit']);

echo "\033[32mAll checks passed.\033[0m\n";
