#!/usr/local/bin/php
<?php

declare(strict_types=1);

if (!is_file(__DIR__.'/../../../vendor/autoload.php')) {
    fwrite(\STDERR, "No vendor/ in this checkout (a new git worktree?). Install it with:\n  ./etc/git/hooks-docker/run-in-php-image.sh composer install\n");
    exit(1);
}

require __DIR__.'/../../../vendor/autoload.php';

use Symfony\Component\Process\Process;

const CHECKED_PATHS = '/^(src\/|tests\/|config\/|composer\.(json|lock)$|phpunit\.dist\.xml$|phpstan\.dist\.neon$|deptrac\.yaml$|\.php-cs-fixer\.dist\.php$)/';
const PHP_FILE = '/\.php$/';

function stagedFiles(string $diffFilter): array
{
    $process = new Process(['git', 'diff', '--cached', '--name-only', "--diff-filter={$diffFilter}"]);
    $process->mustRun();

    return array_values(array_filter(explode("\n", $process->getOutput())));
}

function filesWithUnstagedChanges(): array
{
    $process = new Process(['git', 'diff', '--name-only']);
    $process->mustRun();

    return array_values(array_filter(explode("\n", $process->getOutput())));
}

function runCheck(string $check, array $command): void
{
    echo "\033[32m{$check}\033[0m\n";

    $process = new Process($command);
    $process->setTimeout(3600);
    $process->run(static function (string $type, string $buffer): void {
        echo $buffer;
    });

    if (!$process->isSuccessful()) {
        fwrite(\STDERR, "{$check} failed, fix it before committing.\n");
        exit(1);
    }
}

// Deletions count: removing a class that other code still uses must run the checks.
$staged = stagedFiles('ACMRD');

$checked = array_values(array_filter($staged, static fn (string $file): bool => 1 === preg_match(CHECKED_PATHS, $file)));

if ([] === $checked) {
    exit(0);
}

// The checks read the working tree, so they would pass a broken staged version whose fix is unstaged.
$partlyStaged = array_values(array_intersect($checked, filesWithUnstagedChanges()));

if ([] !== $partlyStaged) {
    fwrite(\STDERR, "These staged files also have unstaged changes, and the checks would read those instead:\n  ".implode("\n  ", $partlyStaged)."\n"
        ."Stage them too, or set the unstaged changes aside, commit, and bring them back. For example:\n"
        ."  git stash push --keep-index -m <unique-message>\n"
        ."then, after the commit, 'git stash apply' that entry and drop it (the stash is shared by every worktree).\n");
    exit(1);
}

if (in_array('composer.json', $staged, true)) {
    // Validate the staged copies, not the working tree, so an updated but unstaged lock is caught.
    // The directory lives in the container's /tmp, which goes away with the container.
    $stagedComposer = sys_get_temp_dir().'/staged-composer';
    mkdir($stagedComposer);
    foreach (['composer.json', 'composer.lock'] as $file) {
        file_put_contents("{$stagedComposer}/{$file}", (new Process(['git', 'show', ":{$file}"]))->mustRun()->getOutput());
    }
    runCheck('composer.json and composer.lock', ['composer', 'validate', '--no-check-publish', '--no-check-all', "{$stagedComposer}/composer.json"]);
}

$phpFiles = array_values(array_filter(
    stagedFiles('ACMR'),
    static fn (string $file): bool => 1 === preg_match(CHECKED_PATHS, $file) && 1 === preg_match(PHP_FILE, $file),
));

// A new fixer version or rule set can flag files that are not staged.
if ([] !== array_intersect(['composer.lock', '.php-cs-fixer.dist.php'], $staged)) {
    runCheck('Coding standard', ['vendor/bin/php-cs-fixer', 'check', '--config=.php-cs-fixer.dist.php']);
} elseif ([] !== $phpFiles) {
    runCheck('Coding standard', ['vendor/bin/php-cs-fixer', 'check', '--config=.php-cs-fixer.dist.php', '--path-mode=intersection', ...$phpFiles]);
}
runCheck('Container', ['bin/console', 'lint:container']);
runCheck('PHPStan', ['vendor/bin/phpstan', 'analyse', '--no-progress']);
runCheck('Layer dependencies', ['vendor/bin/deptrac', '--no-progress']);
runCheck('Tests', ['vendor/bin/phpunit']);

echo "\033[32mAll checks passed.\033[0m\n";
