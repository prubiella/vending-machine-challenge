		{
			"name": "Maintenance",
			"description": "Logs in as the technician of the environment (`technicianUsername`, `technicianPassword`) and keeps the token in the `technicianToken` collection variable, which the technician's requests send. Create that technician once: `make run -- vending:technician:create --username postman --email postman@example.com --password postman-password`.",
			"item": [
				{
					"name": "Log in",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('responds 200', () => pm.response.to.have.status(200));",
									"pm.test('gives a token', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);",
									"pm.collectionVariables.set('technicianToken', pm.response.json().token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"username\": \"{{technicianUsername}}\", \"password\": \"{{technicianPassword}}\"}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
