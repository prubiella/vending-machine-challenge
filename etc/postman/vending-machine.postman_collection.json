					"name": "Health check",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('responds 200', () => pm.response.to.have.status(200));",
									"pm.test('reports the app ok and each dependency', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', checks: { database: 'ok', document_store: 'ok' } }));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/health-check",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health-check"
							]
						}
					},
					"response": []
				},
				{
					"name": "Readiness check",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('responds 200 when every dependency is ok', () => pm.response.to.have.status(200));",
									"pm.test('reports the app ok and each dependency', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', checks: { database: 'ok', document_store: 'ok' } }));"
								]
							}
						}
					],
					"request": {
